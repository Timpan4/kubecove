{
  "name": "kubecove",
  "private": true,
  "version": "0.16.4",
  "packageManager": "bun@1.4.4",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "scripts": {
    "dev": "bun --bun vite",
    "build": "bun run typecheck && bun run build:bundle",
    "build:bundle": "bun --bun vite build",
    "preview": "bun --bun vite preview",
    "test": "bun test",
    "test:svelte": "node --test scripts/svelte-check-tsrs.integration.mjs",
    "test:bench-groups": "node --test scripts/codspeed-frontend-partition.integration.mjs",
    "test:ci": "node --test scripts/ci-workflow-regression.test.mjs scripts/ci-cancel-obsolete.test.mjs scripts/dependabot-automerge.test.mjs",
    "test:release": "node --test scripts/desktop-release-channel.test.mjs scripts/release-workflow-regression.test.mjs",
    "bench": "vitest bench --run",
    "typecheck": "bun scripts/tsrs.ts --noEmit",
    "typecheck:bench": "bun scripts/tsrs.ts --noEmit --project tsconfig.benchmarks.json",
    "svelte:check": "bun scripts/tsrs.ts --svelte --tsconfig tsconfig.svelte.json",
    "lint": "biome lint .",
    "lint:anti-slop": "bun scripts/lint-anti-slop.ts",
    "audit": "bun scripts/audit-dependencies.ts",
    "perf:startup": "bun e2e/lifecycle.ts desktop-profile",
    "perf:frontend": "bun scripts/perf-frontend.ts",
    "perf:resource-scope": "bun scripts/perf-resource-scope.ts",
    "perf:release": "bun scripts/perf-release-footprint.ts",
    "perf:interactions": "bun scripts/dev-interactions-report.ts",
    "rust:bench": "cargo bench --manifest-path rust/Cargo.toml --features bench-support --bench backend_hot_paths",
    "rust:fmt": "node scripts/check-rust-format.mjs",
    "rust:test": "cargo test --workspace --manifest-path rust/Cargo.toml",
    "rust:check": "cargo check --workspace --manifest-path rust/Cargo.toml",
    "rust:lint": "cargo clippy --workspace --manifest-path rust/Cargo.toml --all-targets --all-features -- -D warnings",
    "docs:check": "bun scripts/check-docs.ts",
    "check:frontend": "bun run --parallel docs:check lint lint:anti-slop typecheck typecheck:bench svelte:check test:release test:bench-groups && bun test && bun run test:svelte && bun run build:bundle",
    "check": "bun run rust:fmt && bun run test:ci && bun run check:frontend && bun run rust:test --features desktop-release && bun run rust:check && bun run rust:lint",
    "version:bump": "bun scripts/bump-version.ts",
    "release:prepare": "bun scripts/prepare-release-pr.ts",
    "release:check": "bun scripts/release-beta.ts check",
    "release:dry-run": "bun scripts/release-beta.ts dry-run",
    "release": "bun scripts/release-beta.ts release",
    "e2e:fast": "bun e2e/lifecycle.ts fast",
    "e2e:parity": "bun scripts/e2e-parity.ts",
    "e2e:obscura": "bun scripts/obscura-smoke.ts",
    "e2e:real": "bun e2e/lifecycle.ts run",
    "e2e:cleanup": "bun e2e/lifecycle.ts cleanup",
    "e2e:desktop-smoke": "bun e2e/lifecycle.ts desktop-smoke",
    "dev:kind": "bun e2e/lifecycle.ts dev-up",
    "dev:kind:down": "bun e2e/lifecycle.ts dev-down"
  },
  "dependencies": {
    "@codemirror/commands": "6.11.1",
    "@codemirror/lang-yaml": "6.1.3",
    "@codemirror/language": "6.13.1",
    "@codemirror/lint": "6.9.8",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.15",
    "@fontsource-variable/geist": "5.3.0",
    "@fontsource-variable/inter": "5.3.0",
    "@lezer/highlight": "1.2.5",
    "@tanstack/query-core": "5.108.4",
    "@tanstack/svelte-query": "6.4.7",
    "@tanstack/svelte-virtual": "3.13.54",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/xterm": "6.0.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "diff": "9.0.0",
    "tailwind-merge": "3.7.1",
    "yaml": "2.9.1",
    "zustand": "5.1.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.8",
    "@codspeed/vitest-plugin": "6.1.1",
    "@fontsource-variable/geist-mono": "5.3.0",
    "@oxlint/plugins": "1.95.0",
    "@sveltejs/vite-plugin-svelte": "7.3.2",
    "@tailwindcss/vite": "4.3.5",
    "@types/bun": "1.4.5",
    "@types/ws": "8.18.2",
    "@wdio/cli": "10.2.0",
    "@wdio/globals": "10.2.0",
    "@wdio/local-runner": "10.2.0",
    "@wdio/mocha-framework": "10.2.0",
    "@wdio/spec-reporter": "10.2.0",
    "@xyflow/svelte": "2.0.3",
    "@xyflow/system": "1.0.1",
    "bits-ui": "2.22.0",
    "fast-check": "4.11.0",
    "lucide-svelte": "1.0.1",
    "oxlint": "1.95.0",
    "playwright-core": "1.65.1",
    "svelte": "5.59.1",
    "svelte-check-native": "1.12.1",
    "tailwindcss": "4.3.5",
    "tsrs": "0.20.1-ts7.1.0-beta",
    "tw-animate-css": "1.4.0",
    "vite": "8.3.8",
    "vitest": "5.1.1",
    "vscode-css-languageservice": "6.3.10",
    "webdriverio": "10.2.0",
    "ws": "8.23.0"
  },
  "overrides": {
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.15",
    "@puppeteer/browsers": "3.2.2",
    "axios": "1.20.0",
    "deepmerge-ts": "8.0.1",
    "diff": "9.0.0",
    "follow-redirects": "1.16.2",
    "glob": "14.0.3",
    "js-yaml": "4.3.2",
    "minimatch": "11.0.3",
    "nanoid": "3.3.18",
    "postcss": "8.5.25",
    "serialize-javascript": "7.1.4"
  }
}
