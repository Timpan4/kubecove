{
  "name": "kubecove",
  "private": true,
  "version": "0.13.3",
  "packageManager": "bun@1.4.4",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "scripts": {
    "dev": "bun --bun vite",
    "tauri:dev-server": "bun scripts/tauri-dev-server.ts",
    "build": "bun run typecheck && bun --bun vite build",
    "preview": "bun --bun vite preview",
    "tauri": "bun scripts/tauri.ts",
    "test": "bun test",
    "test:svelte": "node --test scripts/svelte-check-tsrs.integration.mjs",
    "bench": "vitest bench --run",
    "typecheck": "bun scripts/tsrs.ts --noEmit",
    "typecheck:bench": "bun scripts/tsrs.ts --noEmit --project tsconfig.benchmarks.json",
    "svelte:check": "bun scripts/tsrs.ts --svelte --tsconfig tsconfig.svelte.json",
    "lint": "biome lint .",
    "lint:anti-slop": "bun scripts/lint-anti-slop.ts",
    "audit": "bun scripts/audit-dependencies.ts",
    "perf:startup": "bun e2e/lifecycle.ts desktop-profile",
    "perf:frontend": "bun scripts/perf-frontend.ts",
    "perf:resource-scope": "bun scripts/perf-resource-scope.ts",
    "perf:release": "bun scripts/perf-release-footprint.ts",
    "perf:interactions": "bun scripts/dev-interactions-report.ts",
    "rust:bench": "cargo bench --manifest-path src-tauri/Cargo.toml --features bench-support --bench backend_hot_paths",
    "rust:test": "cargo test --workspace --manifest-path src-tauri/Cargo.toml",
    "rust:check": "cargo check --workspace --manifest-path src-tauri/Cargo.toml",
    "rust:lint": "cargo clippy --workspace --manifest-path src-tauri/Cargo.toml --all-targets --all-features -- -D warnings",
    "docs:check": "bun scripts/check-docs.ts",
    "check": "bun run typecheck && bun run typecheck:bench && bun run svelte:check && bun run test:svelte && bun run lint && bun run lint:anti-slop && bun run docs:check && bun test && bun run rust:test && bun run rust:check && bun run rust:lint",
    "version:bump": "bun scripts/bump-version.ts",
    "release:prepare": "bun scripts/prepare-release-pr.ts",
    "release:check": "bun scripts/release-beta.ts check",
    "release:dry-run": "bun scripts/release-beta.ts dry-run",
    "release": "bun scripts/release-beta.ts release",
    "e2e:fast": "bun e2e/lifecycle.ts fast",
    "e2e:obscura": "bun scripts/obscura-smoke.ts",
    "e2e:real": "bun e2e/lifecycle.ts run",
    "e2e:cleanup": "bun e2e/lifecycle.ts cleanup",
    "e2e:desktop-smoke": "bun e2e/lifecycle.ts desktop-smoke",
    "dev:kind": "bun e2e/lifecycle.ts dev-up",
    "dev:kind:down": "bun e2e/lifecycle.ts dev-down"
  },
  "dependencies": {
    "@codemirror/lang-yaml": "6.1.3",
    "@codemirror/language": "6.13.1",
    "@codemirror/lint": "6.9.7",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.15",
    "@fontsource-variable/geist": "5.3.0",
    "@fontsource-variable/inter": "5.3.0",
    "@lezer/highlight": "1.2.5",
    "@tanstack/query-core": "5.105.1",
    "@tanstack/svelte-query": "6.3.7",
    "@tanstack/svelte-virtual": "3.13.51",
    "@tauri-apps/api": "2.12.4",
    "@tauri-apps/plugin-opener": "2.7.2",
    "@tauri-apps/plugin-process": "2.4.0",
    "@tauri-apps/plugin-updater": "2.14.1",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/xterm": "6.0.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "diff": "9.0.0",
    "tailwind-merge": "3.7.0",
    "yaml": "2.9.1",
    "zustand": "5.0.16"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.5",
    "@codspeed/vitest-plugin": "6.1.0",
    "@fontsource-variable/geist-mono": "5.3.0",
    "@oxlint/plugins": "1.91.0",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@tailwindcss/vite": "4.3.4",
    "@tauri-apps/cli": "2.12.4",
    "@types/bun": "1.4.4",
    "@wdio/cli": "10.2.0",
    "@wdio/globals": "10.2.0",
    "@wdio/local-runner": "10.2.0",
    "@wdio/mocha-framework": "10.2.0",
    "@wdio/spec-reporter": "10.2.0",
    "@wdio/tauri-plugin": "1.5.1",
    "@wdio/tauri-service": "1.5.1",
    "@xyflow/svelte": "1.7.1",
    "@xyflow/system": "0.0.84",
    "bits-ui": "2.20.6",
    "fast-check": "4.10.2",
    "lucide-svelte": "1.0.1",
    "oxlint": "1.91.0",
    "playwright-core": "1.65.0",
    "svelte": "5.57.3",
    "svelte-check-native": "1.10.0",
    "tailwindcss": "4.3.4",
    "tsrs": "0.20.1-ts7.1.0-beta",
    "tw-animate-css": "1.4.0",
    "vite": "8.3.6",
    "vitest": "5.1.0",
    "vscode-css-languageservice": "6.3.10",
    "webdriverio": "10.2.0"
  },
  "overrides": {
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.15",
    "@puppeteer/browsers": "3.2.2",
    "axios": "1.20.0",
    "deepmerge-ts": "8.0.1",
    "diff": "9.0.0",
    "follow-redirects": "1.16.2",
    "glob": "14.0.3",
    "js-yaml": "4.3.2",
    "minimatch": "11.0.3",
    "nanoid": "3.3.18",
    "postcss": "8.5.25",
    "serialize-javascript": "7.1.4"
  }
}
