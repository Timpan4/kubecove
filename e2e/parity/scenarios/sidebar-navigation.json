{
  "fixture": "browser-mocks",
  "context": "mock-dev",
  "scenarios": [
    {
      "id": "sidebar.collapse-all",
      "title": "Collapse all clears nested branches without changing resource selection or search",
      "steps": [
        { "action": "openResources" },
        { "action": "search", "value": "payments-api" },
        { "action": "expandNav", "page": "GitOps" },
        { "action": "expandNav", "page": "Argo CD" },
        { "action": "searchCustomKinds", "value": "WGT" },
        { "action": "expandNav", "page": "testing.example.io" },
        { "action": "expandNav", "page": "Helm" },
        { "action": "expectSidebarBranch", "page": "testing.example.io", "expanded": true },
        { "action": "expectSidebarBranch", "page": "Helm", "expanded": true },
        { "action": "expectSidebarBranch", "page": "GitOps", "expanded": true },
        { "action": "expectSidebarBranch", "page": "Argo CD", "expanded": true },
        { "action": "expectSidebarBranch", "page": "Custom Resources", "expanded": true },
        { "action": "collapseSidebar" },
        { "action": "expectSidebarBranch", "page": "GitOps", "expanded": false },
        { "action": "expectSidebarBranch", "page": "Custom Resources", "expanded": false },
        { "action": "expectSidebarBranch", "page": "Helm", "expanded": false },
        { "action": "expectSearch", "value": "payments-api" },
        { "action": "expectResource", "kind": "Deployment", "namespace": "payments", "name": "payments-api" },
        { "action": "collapseSidebar" },
        { "action": "expectSidebarBranch", "page": "GitOps", "expanded": false },
        { "action": "expandNav", "page": "GitOps" },
        { "action": "expectSidebarBranch", "page": "Argo CD", "expanded": false },
        { "action": "expandNav", "page": "Argo CD" },
        { "action": "expectSidebarBranch", "page": "Argo CD", "expanded": true },
        { "action": "searchCustomKinds", "value": "WGT" },
        { "action": "expectSidebarBranch", "page": "testing.example.io", "expanded": false },
        { "action": "expandNav", "page": "testing.example.io" },
        { "action": "expectSidebarBranch", "page": "testing.example.io", "expanded": true }
      ]
    },
    {
      "id": "sidebar.kind-tree",
      "title": "Built-in categories expand lazily and kind selection filters resources",
      "steps": [
        { "action": "openResources" },
        { "action": "collapseSidebar" },
        { "action": "expectSidebarRow", "path": ["Workloads", "Pod"], "visible": false, "selected": false },
        { "action": "sidebarToggle", "path": ["Workloads"] },
        { "action": "expectSidebarRow", "path": ["Workloads", "Pod"], "visible": true, "selected": false },
        { "action": "expectSidebarRow", "path": ["Workloads", "Deployment"], "visible": true, "selected": false },
        { "action": "expectSidebarRow", "path": ["Workloads", "ReplicaSet"], "visible": true, "selected": false },
        { "action": "expectSidebarRow", "path": ["Workloads", "StatefulSet"], "visible": true, "selected": false },
        { "action": "expectSidebarRow", "path": ["Workloads", "DaemonSet"], "visible": true, "selected": false },
        { "action": "expectSidebarRow", "path": ["Workloads", "Job"], "visible": true, "selected": false },
        { "action": "expectSidebarRow", "path": ["Workloads", "CronJob"], "visible": true, "selected": false },
        { "action": "collapseSidebar" },
        { "action": "expectSidebarRow", "path": ["Workloads", "Pod"], "visible": false, "selected": false },
        { "action": "expectSidebarRow", "path": ["Network", "Service"], "visible": false, "selected": false },
        { "action": "sidebarToggle", "path": ["Network"] },
        { "action": "expectSidebarRow", "path": ["Network", "Service"], "visible": true, "selected": false },
        { "action": "expectSidebarRow", "path": ["Network", "Ingress"], "visible": true, "selected": false },
        { "action": "collapseSidebar" },
        { "action": "expectSidebarRow", "path": ["Network", "Service"], "visible": false, "selected": false },
        { "action": "expectSidebarRow", "path": ["Config", "ConfigMap"], "visible": false, "selected": false },
        { "action": "sidebarToggle", "path": ["Config"] },
        { "action": "expectSidebarRow", "path": ["Config", "ConfigMap"], "visible": true, "selected": false },
        { "action": "expectSidebarRow", "path": ["Config", "Secret"], "visible": true, "selected": false },
        { "action": "collapseSidebar" },
        { "action": "expectSidebarRow", "path": ["Config", "ConfigMap"], "visible": false, "selected": false },
        { "action": "expectSidebarRow", "path": ["Storage", "PersistentVolumeClaim"], "visible": false, "selected": false },
        { "action": "sidebarToggle", "path": ["Storage"] },
        { "action": "expectSidebarRow", "path": ["Storage", "PersistentVolumeClaim"], "visible": true, "selected": false },
        { "action": "expectSidebarRow", "path": ["Storage", "PersistentVolume"], "visible": true, "selected": false },
        { "action": "expectSidebarRow", "path": ["Storage", "StorageClass"], "visible": true, "selected": false },
        { "action": "collapseSidebar" },
        { "action": "expectSidebarRow", "path": ["Storage", "PersistentVolumeClaim"], "visible": false, "selected": false },
        { "action": "expectSidebarRow", "path": ["Cluster Overview", "Node"], "visible": false, "selected": false },
        { "action": "sidebarToggle", "path": ["Cluster Overview"] },
        { "action": "expectSidebarRow", "path": ["Cluster Overview", "Node"], "visible": true, "selected": false },
        { "action": "expectSidebarRow", "path": ["Cluster Overview", "StorageClass"], "visible": true, "selected": false },
        { "action": "expectSidebarRow", "path": ["Cluster Overview", "PersistentVolume"], "visible": true, "selected": false },
        { "action": "collapseSidebar" },
        { "action": "expectSidebarRow", "path": ["Cluster Overview", "Node"], "visible": false, "selected": false },
        { "action": "expectSidebarRow", "path": ["RBAC", "Namespace Access"], "visible": false, "selected": false },
        { "action": "sidebarToggle", "path": ["RBAC"] },
        { "action": "expectSidebarRow", "path": ["RBAC", "Namespace Access"], "visible": true, "selected": false },
        { "action": "expectSidebarRow", "path": ["RBAC", "Roles"], "visible": true, "selected": false },
        { "action": "expectSidebarRow", "path": ["RBAC", "Cluster Roles"], "visible": true, "selected": false },
        { "action": "expectSidebarRow", "path": ["RBAC", "Bindings"], "visible": true, "selected": false },
        { "action": "expectSidebarRow", "path": ["RBAC", "Service Accounts"], "visible": true, "selected": false },
        { "action": "collapseSidebar" },
        { "action": "expectSidebarRow", "path": ["RBAC", "Namespace Access"], "visible": false, "selected": false },
        { "action": "sidebarToggle", "path": ["Workloads"] },
        { "action": "sidebarSelect", "path": ["Workloads", "Deployment"] },
        { "action": "expectSidebarRow", "path": ["Workloads", "Deployment"], "visible": true, "selected": true },
        { "action": "expectResource", "kind": "Deployment", "namespace": "payments", "name": "payments-api" },
        { "action": "expectNoClusterResource", "kind": "Pod", "name": "payments-api-7d9c9b7f8d-k2r9p" }
      ]
    },
    {
      "id": "sidebar.namespace-tree",
      "title": "Namespace expansion preserves selection and children retain their own scope",
      "steps": [
        { "action": "openResources" },
        { "action": "collapseSidebar" },
        { "action": "selectNamespace", "namespace": "payments" },
        { "action": "expectSidebarRow", "path": ["payments"], "visible": true, "selected": true },
        { "action": "sidebarToggle", "path": ["default"] },
        { "action": "expectSidebarRow", "path": ["payments"], "visible": true, "selected": true },
        { "action": "sidebarToggle", "path": ["payments"] },
        { "action": "expectSidebarRow", "path": ["payments", "Workloads", "Pod"], "visible": false, "selected": false },
        { "action": "sidebarToggle", "path": ["payments", "Workloads"] },
        { "action": "sidebarSelect", "path": ["payments", "Workloads", "Pod"] },
        { "action": "expectSidebarRow", "path": ["payments", "Workloads", "Pod"], "visible": true, "selected": true },
        { "action": "expectResource", "kind": "Pod", "namespace": "payments", "name": "payments-api-7d9c9b7f8d-k2r9p" },
        { "action": "sidebarToggle", "path": ["default", "Workloads"] },
        { "action": "sidebarSelect", "path": ["default", "Workloads", "Pod"] },
        { "action": "expectSidebarRow", "path": ["default", "Workloads", "Pod"], "visible": true, "selected": true },
        { "action": "expectNoClusterResource", "kind": "Pod", "name": "payments-api-7d9c9b7f8d-k2r9p" },
        { "action": "sidebarSelect", "path": ["payments", "Workloads", "Pod"] },
        { "action": "expectResource", "kind": "Pod", "namespace": "payments", "name": "payments-api-7d9c9b7f8d-k2r9p" },
        { "action": "collapseSidebar" },
        { "action": "expectSidebarRow", "path": ["payments", "Workloads"], "visible": false, "selected": false },
        { "action": "sidebarToggle", "path": ["payments"] },
        { "action": "expectSidebarRow", "path": ["payments", "Workloads", "Pod"], "visible": false, "selected": false }
      ]
    },
    {
      "id": "sidebar.namespace-builtins-without-custom",
      "title": "Hiding custom resources preserves built-in namespace children",
      "steps": [
        { "action": "openSettings" },
        { "action": "toggleSetting", "setting": "Show Custom Resources" },
        { "action": "closeSettings" },
        { "action": "openResources" },
        { "action": "collapseSidebar" },
        { "action": "sidebarToggle", "path": ["payments"] },
        { "action": "sidebarToggle", "path": ["payments", "Config"] },
        { "action": "expectSidebarRow", "path": ["payments", "Config", "Secret"], "visible": true, "selected": false }
      ]
    },
    {
      "id": "sidebar.namespace-custom",
      "title": "Namespace custom children use present kinds and collapse with their parents",
      "steps": [
        { "action": "openResources" },
        { "action": "collapseSidebar" },
        { "action": "sidebarToggle", "path": ["argocd"] },
        { "action": "sidebarToggle", "path": ["argocd", "Custom Resources"] },
        { "action": "sidebarToggle", "path": ["argocd", "Custom Resources", "argoproj.io"] },
        { "action": "sidebarSelect", "path": ["argocd", "Custom Resources", "argoproj.io", "Application"] },
        { "action": "expectSidebarRow", "path": ["argocd", "Custom Resources", "argoproj.io", "Application"], "visible": true, "selected": true },
        { "action": "expectResource", "kind": "Application", "namespace": "argocd", "name": "shop" },
        { "action": "sidebarToggle", "path": ["payments"] },
        { "action": "expectSidebarRow", "path": ["payments", "Custom Resources"], "visible": false, "selected": false },
        { "action": "collapseSidebar" },
        { "action": "sidebarToggle", "path": ["argocd"] },
        { "action": "expectSidebarRow", "path": ["argocd", "Custom Resources", "argoproj.io"], "visible": false, "selected": false }
      ]
    },
    {
      "id": "sidebar.storage-scope",
      "title": "Namespace storage preserves PVC scope and cluster kind children stay selectable",
      "steps": [
        { "action": "openResources" },
        { "action": "collapseSidebar" },
        { "action": "sidebarToggle", "path": ["platform"] },
        { "action": "sidebarToggle", "path": ["platform", "Storage"] },
        { "action": "sidebarSelect", "path": ["platform", "Storage"] },
        { "action": "expectSidebarRow", "path": ["platform", "Storage"], "visible": true, "selected": true },
        { "action": "expectResource", "kind": "PersistentVolumeClaim", "namespace": "platform", "name": "metrics-gateway-cache" },
        { "action": "expectNoResource", "kind": "PersistentVolumeClaim", "namespace": "tenant-ledger", "name": "data-ledger-0" },
        { "action": "sidebarSelect", "path": ["platform", "Storage", "PersistentVolume"] },
        { "action": "expectClusterResource", "kind": "PersistentVolume", "name": "pv-metrics-gateway-cache" },
        { "action": "sidebarToggle", "path": ["Workloads"] },
        { "action": "search", "value": "metrics-gateway" },
        { "action": "expectSearch", "value": "metrics-gateway" },
        { "action": "sidebarSelect", "path": ["Workloads", "Deployment"] },
        { "action": "expectSearch", "value": "" },
        { "action": "expectPageText", "text": "Kind Deployment" },
        { "action": "expectResource", "kind": "Deployment", "namespace": "payments", "name": "payments-api" },
        { "action": "expectResource", "kind": "Deployment", "namespace": "tenant-catalog", "name": "catalog" },
        { "action": "sidebarToggle", "path": ["Cluster Overview"] },
        { "action": "sidebarSelect", "path": ["Cluster Overview", "Node"] },
        { "action": "expectClusterResource", "kind": "Node", "name": "dev-control-plane" },
        { "action": "sidebarToggle", "path": ["RBAC"] },
        { "action": "sidebarSelect", "path": ["RBAC", "Roles"] },
        { "action": "expectSidebarRow", "path": ["RBAC", "Roles"], "visible": true, "selected": true },
        { "action": "sidebarSelect", "path": ["RBAC"] },
        { "action": "expectSidebarRow", "path": ["RBAC"], "visible": true, "selected": true },
        { "action": "sidebarSelect", "path": ["Cluster Overview"] },
        { "action": "expectSidebarRow", "path": ["Cluster Overview"], "visible": true, "selected": true },
        { "action": "expectClusterResource", "kind": "Node", "name": "dev-control-plane" },
        { "action": "expectClusterResource", "kind": "StorageClass", "name": "local-path" }
      ]
    }
  ]
}
