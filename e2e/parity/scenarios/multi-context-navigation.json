{
  "fixture": "browser-mocks",
  "context": "mock-dev",
  "scenarios": [
    {
      "id": "multi-context-navigation.helm-release-other-context",
      "title": "Open Helm release from a second-context Pod reads that context's release, and the Helm node returns to the primary context",
      "steps": [
        { "action": "openLauncher" },
        { "action": "editSavedWorkspace", "name": "Parity mock workspace" },
        { "action": "toggleWorkspaceContext", "context": "admin@solid-k8s" },
        { "action": "saveWorkspace" },
        { "action": "openSavedWorkspace", "name": "Parity mock workspace" },
        { "action": "openResources" },
        { "action": "search", "value": "metrics-gateway-9f6d4f7c9-7j2p4" },
        { "action": "openResource", "kind": "Pod", "namespace": "platform", "name": "metrics-gateway-9f6d4f7c9-7j2p4", "context": "admin@solid-k8s" },
        { "action": "expectDetailContext", "context": "admin@solid-k8s" },
        { "action": "clickDetailControl", "label": "Open Helm release" },
        { "action": "expectHelmContext", "context": "admin@solid-k8s" },
        { "action": "expectHelmDetails", "title": "metrics-gateway", "description": "platform / Secret:sh.helm.release.v1.metrics-gateway.v9", "totals": "4 tracked, 1 missing, 0 label-only" },
        { "action": "openPage", "page": "Helm" },
        { "action": "expectHelmContext", "context": "mock-dev" },
        { "action": "openHelmRelease", "name": "metrics-gateway", "namespace": "platform" },
        { "action": "expectHelmDetails", "title": "metrics-gateway", "description": "platform / Secret:sh.helm.release.v1.metrics-gateway.v7", "totals": "4 tracked, 1 missing, 0 label-only" }
      ]
    },
    {
      "id": "multi-context-navigation.helm-release-draft-refused",
      "title": "A YAML refusal leaves an in-flight primary Helm navigation pointed at the primary context",
      "steps": [
        { "action": "openLauncher" },
        { "action": "editSavedWorkspace", "name": "Parity mock workspace" },
        { "action": "toggleWorkspaceContext", "context": "admin@solid-k8s" },
        { "action": "saveWorkspace" },
        { "action": "openSavedWorkspace", "name": "Parity mock workspace" },
        { "action": "openResources" },
        { "action": "search", "value": "metrics-gateway-9f6d4f7c9-7j2p4" },
        { "action": "openResource", "kind": "Pod", "namespace": "platform", "name": "metrics-gateway-9f6d4f7c9-7j2p4", "context": "admin@solid-k8s" },
        { "action": "showTab", "tab": "Exec" },
        { "action": "execControl", "operation": "start", "container": "app", "command": "/bin/sh" },
        { "action": "expectExecState", "container": "app", "status": "running", "contains": "Controlled exec app" },
        { "action": "coverageScript", "script": "stop-pending" },
        { "action": "openPage", "page": "Helm" },
        { "action": "confirmExecLeave", "choice": "stop" },
        { "action": "showYaml" },
        { "action": "editYaml" },
        { "action": "replaceYamlDraft", "value": "apiVersion: v1\nkind: Pod\nmetadata:\n  name: metrics-gateway-9f6d4f7c9-7j2p4\n  namespace: platform\n  labels:\n    draft: kept\n" },
        { "action": "showTab", "tab": "Details" },
        { "action": "clickDetailControl", "label": "Open Helm release" },
        { "action": "expectYamlNotice", "title": "This local draft has unsaved changes. Discard the local draft before changing target or closing." },
        { "action": "expectDetailContext", "context": "admin@solid-k8s" },
        { "action": "showYaml" },
        { "action": "cancelYamlEdit" },
        { "action": "coverageScript", "script": "base" },
        { "action": "expectHelmContext", "context": "mock-dev" },
        { "action": "expectHelmCount", "count": 3 },
        { "action": "expectNoPageText", "text": "platform / Secret:sh.helm.release.v1.metrics-gateway.v7" }
      ]
    },
    {
      "id": "multi-context-navigation.helm-release-exec-leave",
      "title": "Stay and a failed exec stop keep the Pod open, and a successful stop opens the exact Helm release",
      "steps": [
        { "action": "openLauncher" },
        { "action": "editSavedWorkspace", "name": "Parity mock workspace" },
        { "action": "toggleWorkspaceContext", "context": "admin@solid-k8s" },
        { "action": "saveWorkspace" },
        { "action": "openSavedWorkspace", "name": "Parity mock workspace" },
        { "action": "openResources" },
        { "action": "search", "value": "metrics-gateway-9f6d4f7c9-7j2p4" },
        { "action": "openResource", "kind": "Pod", "namespace": "platform", "name": "metrics-gateway-9f6d4f7c9-7j2p4", "context": "admin@solid-k8s" },
        { "action": "showTab", "tab": "Exec" },
        { "action": "execControl", "operation": "start", "container": "app", "command": "/bin/sh" },
        { "action": "expectExecState", "container": "app", "status": "running", "contains": "Controlled exec app" },
        { "action": "showTab", "tab": "Details" },
        { "action": "clickDetailControl", "label": "Open Helm release" },
        { "action": "confirmExecLeave", "choice": "stay" },
        { "action": "showTab", "tab": "Exec" },
        { "action": "expectExecState", "container": "app", "status": "running", "contains": "Controlled exec app" },
        { "action": "coverageScript", "script": "stop-failed" },
        { "action": "showTab", "tab": "Details" },
        { "action": "clickDetailControl", "label": "Open Helm release" },
        { "action": "confirmExecLeave", "choice": "stop" },
        { "action": "showTab", "tab": "Exec" },
        { "action": "expectExecState", "container": "app", "status": "error", "contains": "stop failed" },
        { "action": "expectDetailContext", "context": "admin@solid-k8s" },
        { "action": "coverageScript", "script": "stop-pending" },
        { "action": "showTab", "tab": "Details" },
        { "action": "clickDetailControl", "label": "Open Helm release" },
        { "action": "confirmExecLeave", "choice": "stop" },
        { "action": "expectDetailContext", "context": "admin@solid-k8s" },
        { "action": "coverageScript", "script": "base" },
        { "action": "expectHelmContext", "context": "admin@solid-k8s" },
        { "action": "expectHelmDetails", "title": "metrics-gateway", "description": "platform / Secret:sh.helm.release.v1.metrics-gateway.v9", "totals": "4 tracked, 1 missing, 0 label-only" }
      ]
    },
    {
      "id": "multi-context-navigation.helm-context-per-workspace",
      "title": "A Helm context opened from a resource stays with its workspace: another workspace left on Helm reads its own primary context, and reopening the first restores its release",
      "steps": [
        { "action": "openLauncher" },
        { "action": "nameWorkspace", "value": "Helm context peer" },
        { "action": "createWorkspace" },
        { "action": "expectOpenWorkspace", "name": "Helm context peer", "context": "mock-dev" },
        { "action": "openLauncher" },
        { "action": "editSavedWorkspace", "name": "Helm context peer" },
        { "action": "toggleWorkspaceContext", "context": "admin@solid-k8s" },
        { "action": "saveWorkspace" },
        { "action": "openSavedWorkspace", "name": "Helm context peer" },
        { "action": "openPage", "page": "Helm" },
        { "action": "expectHelmContext", "context": "mock-dev" },
        { "action": "openLauncher" },
        { "action": "editSavedWorkspace", "name": "Parity mock workspace" },
        { "action": "toggleWorkspaceContext", "context": "admin@solid-k8s" },
        { "action": "saveWorkspace" },
        { "action": "openSavedWorkspace", "name": "Parity mock workspace" },
        { "action": "openResources" },
        { "action": "search", "value": "metrics-gateway-9f6d4f7c9-7j2p4" },
        { "action": "openResource", "kind": "Pod", "namespace": "platform", "name": "metrics-gateway-9f6d4f7c9-7j2p4", "context": "admin@solid-k8s" },
        { "action": "clickDetailControl", "label": "Open Helm release" },
        { "action": "expectHelmContext", "context": "admin@solid-k8s" },
        { "action": "openLauncher" },
        { "action": "openSavedWorkspace", "name": "Helm context peer" },
        { "action": "expectHelmContext", "context": "mock-dev" },
        { "action": "openLauncher" },
        { "action": "openSavedWorkspace", "name": "Parity mock workspace" },
        { "action": "expectHelmContext", "context": "admin@solid-k8s" },
        { "action": "expectHelmDetails", "title": "metrics-gateway", "description": "platform / Secret:sh.helm.release.v1.metrics-gateway.v9", "totals": "4 tracked, 1 missing, 0 label-only" }
      ]
    },
    {
      "id": "multi-context-navigation.helm-selection-per-workspace",
      "title": "A release selected in one workspace stays out of another workspace on the same context, and returns when its workspace reopens",
      "steps": [
        { "action": "openPage", "page": "Helm" },
        { "action": "openHelmRelease", "name": "metrics-gateway", "namespace": "platform" },
        { "action": "expectHelmDetails", "title": "metrics-gateway", "description": "platform / Secret:sh.helm.release.v1.metrics-gateway.v7", "totals": "4 tracked, 1 missing, 0 label-only" },
        { "action": "openLauncher" },
        { "action": "nameWorkspace", "value": "Helm selection peer" },
        { "action": "createWorkspace" },
        { "action": "expectOpenWorkspace", "name": "Helm selection peer", "context": "mock-dev" },
        { "action": "openPage", "page": "Helm" },
        { "action": "expectHelmCount", "count": 3 },
        { "action": "expectNoPageText", "text": "platform / Secret:sh.helm.release.v1.metrics-gateway.v7" },
        { "action": "openLauncher" },
        { "action": "openSavedWorkspace", "name": "Parity mock workspace" },
        { "action": "expectHelmDetails", "title": "metrics-gateway", "description": "platform / Secret:sh.helm.release.v1.metrics-gateway.v7", "totals": "4 tracked, 1 missing, 0 label-only" },
        { "action": "openLauncher" },
        { "action": "openSavedWorkspace", "name": "Helm selection peer" },
        { "action": "expectHelmCount", "count": 3 },
        { "action": "expectNoPageText", "text": "platform / Secret:sh.helm.release.v1.metrics-gateway.v7" }
      ]
    },
    {
      "id": "multi-context-navigation.helm-namespace-per-workspace",
      "title": "A Helm namespace filter chosen in one workspace does not filter another workspace's Helm page",
      "steps": [
        { "action": "openPage", "page": "Helm" },
        { "action": "expectHelmCount", "count": 3 },
        { "action": "selectHelmNamespace", "namespace": "platform" },
        { "action": "expectHelmCount", "count": 1 },
        { "action": "openLauncher" },
        { "action": "nameWorkspace", "value": "Helm namespace peer" },
        { "action": "createWorkspace" },
        { "action": "expectOpenWorkspace", "name": "Helm namespace peer", "context": "mock-dev" },
        { "action": "openPage", "page": "Helm" },
        { "action": "expectHelmCount", "count": 3 }
      ]
    },
    {
      "id": "multi-context-navigation.gitops-application-namespace",
      "title": "A recent Application reopens in its own namespace when another namespace has an Application with the same name",
      "steps": [
        { "action": "openPage", "page": "GitOps" },
        { "action": "configureArgoInventory", "mode": "same-name" },
        { "action": "openGitOpsResources", "kind": "Application", "name": "tenant-catalog", "namespace": "tenants" },
        { "action": "openPage", "page": "Workspace Overview" },
        { "action": "expectWorkspaceEntry", "panel": "Recent", "label": "Application / tenant-catalog", "index": 0, "count": 1 },
        { "action": "openWorkspaceEntry", "panel": "Recent", "label": "Application / tenant-catalog", "index": 0, "count": 1 },
        { "action": "expectGitOpsSelection", "name": "tenant-catalog", "namespace": "tenants" }
      ]
    }
  ]
}
