        { "action": "expectRuntimeEndpoint", "value": "local" },
        { "action": "showSettingsSection", "section": "General" },
        { "action": "expectNoSettingRow", "title": "Server information" },
        { "action": "expectNoSettingsText", "value": "Encrypted file storage" },
        { "action": "searchSettings", "value": "credential storage" },
        { "action": "expectSettingsEmpty", "value": "credential storage" }
