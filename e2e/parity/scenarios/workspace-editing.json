          "name": "Parity mock workspace"
        },
        {
          "action": "toggleWorkspaceNamespace",
          "namespace": "payments"
        },
        {
          "action": "toggleWorkspaceContext",
          "context": "admin@solid-k8s"
        },
        {
          "action": "saveWorkspace"
        },
        {
          "action": "openSavedWorkspace",
          "name": "Parity mock workspace"
        },
        {
          "action": "expectOverviewHealth",
          "total": 18
