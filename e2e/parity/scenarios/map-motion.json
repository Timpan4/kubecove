      "steps": [
        { "action": "openResources" },
        { "action": "setWindowActive", "active": true },
        { "action": "search", "value": "payments-api" },
        { "action": "expectTopologyEdgeMotion", "source": "mock-dev:apps/v1:Deployment:payments:payments-api", "target": "mock-dev:apps/v1:ReplicaSet:payments:payments-api-7d9c9b7f8d", "flow": false, "pulse": false },
        { "action": "selectTopologyNode", "id": "mock-dev:apps/v1:Deployment:payments:payments-api" },
        { "action": "expectTopologyEdgeMotion", "source": "mock-dev:apps/v1:Deployment:payments:payments-api", "target": "mock-dev:apps/v1:ReplicaSet:payments:payments-api-7d9c9b7f8d", "flow": true, "pulse": false }
      ]
    },
    {
