{
  "fixture": "browser-mocks",
  "context": "mock-dev",
  "scenarios": [
    {
      "id": "state.timeline-after-event-refresh",
      "title": "A live event refresh replaces the Details timeline entries",
      "steps": [
        { "action": "openResources" },
        { "action": "search", "value": "payments-api" },
        { "action": "openResource", "kind": "Deployment", "name": "payments-api", "namespace": "payments" },
        { "action": "showTab", "tab": "Details" },
        { "action": "expectPageText", "text": "Readiness probe failed" },
        { "action": "showTab", "tab": "Events" },
        { "action": "replayLiveData", "script": "events" },
        { "action": "showTab", "tab": "Details" },
        { "action": "expectNoPageText", "text": "Readiness probe failed" }
      ]
    },
    {
      "id": "state.argo-submit-outcome-after-close",
      "title": "An accepted operation is observed when its detail closes during submission",
      "steps": [
        { "action": "openPage", "page": "GitOps" },
        { "action": "openGitOpsDetails", "kind": "Application", "name": "tenant-ledger", "namespace": "argocd" },
        { "action": "connectArgoProfile", "url": "https://argocd.example.test" },
        { "action": "reviewArgoOperation", "operation": "Sync" },
        { "action": "mockTiming", "control": { "operation": "hold", "command": "run_argo_operation", "context": "" } },
        { "action": "confirmArgoReview" },
        { "action": "closeDetail" },
        { "action": "mockTiming", "control": { "operation": "release", "command": "run_argo_operation", "context": "" } },
        { "action": "completeArgoOperation" },
        { "action": "openGitOpsDetails", "kind": "Application", "name": "tenant-ledger", "namespace": "argocd" },
        { "action": "expectArgoText", "text": "Argo CD confirmed completion" }
      ]
    }
  ]
}
