{
	"fixture": "browser-mocks",
	"context": "mock-dev",
	"scenarios": [
		{
			"id": "coverage-rbac.verify-without-selection",
			"title": "With no RBAC object to select, Investigate identity still shows a verifier that runs a live review",
			"steps": [
				{
					"action": "openPage",
					"page": "RBAC"
				},
				{
					"action": "coverageFill",
					"label": "Search RBAC objects",
					"value": "no-such-rbac-object"
				},
				{
					"action": "coverageText",
					"text": "No matching RBAC objects.",
					"visible": true
				},
				{
					"action": "coverageClick",
					"label": "Investigate identity"
				},
				{
					"action": "coverageFill",
					"label": "Identity name",
					"value": "alice"
				},
				{
					"action": "verifyRbacAccess",
					"verb": "get"
				},
				{
					"action": "expectRbacVerdict",
					"outcome": "allowed"
				}
			]
		},
		{
			"id": "coverage-rbac.role-manual-identity",
			"title": "On a Role, typing an identity name keeps the manual identity form editable",
			"steps": [
				{
					"action": "openPage",
					"page": "RBAC"
				},
				{
					"action": "selectRbacCategory",
					"category": "Roles"
				},
				{
					"action": "selectRbacItem",
					"title": "Role/payments-reader"
				},
				{
					"action": "coverageFill",
					"label": "Identity name",
					"value": "a"
				},
				{
					"action": "coverageFill",
					"label": "Identity name",
					"value": "alice"
				},
				{
					"action": "expectRbacGrant",
					"grant": "get, list, watch · core/pods, services, configmaps"
				},
				{
					"action": "coverageFill",
					"label": "Groups",
					"value": "developers,system:authenticated"
				},
				{
					"action": "verifyRbacAccess",
					"verb": "get"
				},
				{
					"action": "expectRbacVerdict",
					"outcome": "allowed"
				}
			]
		},
		{
			"id": "rbac.service-account-namespace-required",
			"title": "A ServiceAccount without a namespace disables Verify, says why, and hides the default namespace account grants as unknown",
			"steps": [
				{
					"action": "openPage",
					"page": "RBAC"
				},
				{
					"action": "selectRbacCategory",
					"category": "Roles"
				},
				{
					"action": "selectRbacItem",
					"title": "Role/payments-reader"
				},
				{
					"action": "coverageClick",
					"label": "ServiceAccount"
				},
				{
					"action": "coverageFill",
					"label": "Identity name",
					"value": "deployer"
				},
				{
					"action": "coverageFill",
					"label": "ServiceAccount namespace",
					"value": ""
				},
				{
					"action": "coverageText",
					"text": "Enter the ServiceAccount namespace to verify.",
					"visible": true
				},
				{
					"action": "expectRbacVerifyEnabled",
					"enabled": false
				},
				{
					"action": "coverageText",
					"text": "Unknown · The ServiceAccount namespace is missing.",
					"visible": true
				},
				{
					"action": "expectNoRbacGrant",
					"grant": "get, list, watch · core/pods, services, configmaps"
				},
				{
					"action": "coverageText",
					"text": "payments · ServiceAccount deployer (namespace required)",
					"visible": true
				},
				{
					"action": "coverageFill",
					"label": "ServiceAccount namespace",
					"value": "default"
				},
				{
					"action": "expectRbacVerifyEnabled",
					"enabled": true
				},
				{
					"action": "coverageText",
					"text": "Enter the ServiceAccount namespace to verify.",
					"visible": false
				},
				{
					"action": "expectRbacGrant",
					"grant": "get, list, watch · core/pods, services, configmaps"
				}
			]
		}
	]
}
