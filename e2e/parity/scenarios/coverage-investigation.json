			"id": "coverage-forward.copy-url",
			"title": "Copy uses the selected forward local URL and failures retain its exact target and resolved Pod",
			"steps": [
				{
					"action": "openResources"
				},
				{
					"action": "openResource",
					"kind": "Service",
