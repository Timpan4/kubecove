					"count": 1
				},
				{
					"action": "coverageCopy",
					"label": "Copy",
					"text": "http://127.0.0.1:18081",
					"match": "exact"
				},
				{
					"action": "replaySessions",
					"script": "failed"
				},
				{
					"action": "expectForwardState",
