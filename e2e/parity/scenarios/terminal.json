    {
      "id": "exec-session.drag-hard-lines",
      "title": "Drag copy preserves hard newlines and excludes terminal padding",
      "steps": [
        {
          "action": "openResources"
        },
        {
          "action": "openResource",
          "kind": "Pod",
          "namespace": "payments",
          "name": "payments-api-7d9c9b7f8d-k2r9p"
        },
        {
          "action": "showTab",
          "tab": "Exec"
        },
        {
          "action": "execControl",
          "operation": "start",
          "container": "app",
          "command": "/bin/sh"
        },
        {
          "action": "expectExecState",
          "container": "app",
          "status": "running",
          "contains": "Controlled exec app"
        },
        {
          "action": "terminalOutput",
          "container": "app",
          "data": "\u001b[2J\u001b[Halpha beta\r\nsecond line\r\n"
        },
        {
          "action": "terminalSelect",
          "row": 0,
          "col": 0,
          "endRow": 1,
          "endCol": 11,
          "word": false
        },
        {
          "action": "terminalCopy",
          "text": "alpha beta\nsecond line"
        }
      ]
    },
