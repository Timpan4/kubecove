      "steps": [
        { "action": "openResources" },
        { "action": "search", "value": "checkout-worker" },
        { "action": "expectResourceGroup", "label": "Owned by Argo CD: shop (partial evidence)", "expanded": true },
        { "action": "expectResource", "kind": "Pod", "name": "checkout-worker-6bfbd7d5dd-9qj2f", "namespace": "payments" },
        { "action": "expectResourceCell", "kind": "Pod", "name": "checkout-worker-6bfbd7d5dd-9qj2f", "namespace": "payments", "column": "Owner", "text": "shop" },
        { "action": "chooseGitOpsOwner", "owner": "Owned by Argo CD: shop (partial evidence)" },
        { "action": "expectResource", "kind": "Pod", "name": "checkout-worker-6bfbd7d5dd-9qj2f", "namespace": "payments" },
        { "action": "chooseGitOpsOwner", "owner": "All GitOps owners" },
        { "action": "replayLiveData", "script": "ownership" },
