{
  "fixture": "browser-mocks",
  "context": "mock-dev",
  "scenarios": [
    {
      "id": "resources.table-search-identity",
      "title": "Search matches API identity, GitOps owner terms and Helm release",
      "steps": [
        { "action": "openResources" },
        { "action": "search", "value": "apps/v1" },
        { "action": "expectResource", "kind": "Deployment", "name": "checkout-worker", "namespace": "payments" },
        { "action": "expectNoResource", "kind": "Service", "name": "payments-api", "namespace": "payments" },
        { "action": "search", "value": "application" },
        { "action": "expectResource", "kind": "Pod", "name": "payments-api-7d9c9b7f8d-k2r9p", "namespace": "payments" },
        { "action": "search", "value": "metrics-gateway" },
        { "action": "expectResource", "kind": "Deployment", "name": "metrics-gateway", "namespace": "platform" }
      ]
    },
    {
      "id": "resources.table-sort",
      "title": "Column headers sort ascending, then descending, with name ties",
      "steps": [
        { "action": "openResources" },
        { "action": "search", "value": "payments-api-7d9c9b7f8d" },
        { "action": "expectResourceOrder", "names": ["payments-api-7d9c9b7f8d-k2r9p", "payments-api-7d9c9b7f8d-x4m8v"] },
        { "action": "sortResourceTable", "column": "Restarts" },
        { "action": "expectResourceOrder", "names": ["payments-api-7d9c9b7f8d-x4m8v", "payments-api-7d9c9b7f8d-k2r9p"] },
        { "action": "sortResourceTable", "column": "Restarts" },
        { "action": "expectResourceOrder", "names": ["payments-api-7d9c9b7f8d-k2r9p", "payments-api-7d9c9b7f8d-x4m8v"] },
        { "action": "sortResourceTable", "column": "Name" },
        { "action": "expectResourceOrder", "names": ["payments-api-7d9c9b7f8d-k2r9p", "payments-api-7d9c9b7f8d-x4m8v"] },
        { "action": "sortResourceTable", "column": "Name" },
        { "action": "expectResourceOrder", "names": ["payments-api-7d9c9b7f8d-x4m8v", "payments-api-7d9c9b7f8d-k2r9p"] }
      ]
    },
    {
      "id": "resources.table-sort-live-patch",
      "title": "A watch patch that changes the sorted Status re-sorts the rows",
      "steps": [
        { "action": "openResources" },
        { "action": "expectLiveState", "label": "Live" },
        { "action": "search", "value": "apps/v1" },
        { "action": "sortResourceTable", "column": "Status" },
        { "action": "expectResourceOrder", "names": ["checkout-worker", "payments-api"] },
        { "action": "replayLiveData", "script": "update" },
        { "action": "expectResourceStatus", "kind": "Deployment", "namespace": "payments", "name": "payments-api", "status": "Degraded" },
        { "action": "expectResourceOrder", "names": ["payments-api", "checkout-worker"] }
      ]
    },
    {
      "id": "resources.table-sort-live-add",
      "title": "A row a watch adds takes its place in the Name sort",
      "steps": [
        { "action": "openResources" },
        { "action": "expectLiveState", "label": "Live" },
        { "action": "search", "value": "apps/v1" },
        { "action": "sortResourceTable", "column": "Name" },
        { "action": "expectResourceOrder", "names": ["payments-api", "checkout-worker"] },
        { "action": "replayLiveData", "script": "add" },
        { "action": "expectResource", "kind": "Deployment", "name": "orders-api", "namespace": "payments" },
        { "action": "expectResourceOrder", "names": ["payments-api", "orders-api", "checkout-worker"] }
      ]
    },
    {
      "id": "resources.table-groups",
      "title": "Ownership and kind group rows collapse and expand their rows",
      "steps": [
        { "action": "openResources" },
        { "action": "search", "value": "payments-api-7d9c9b7f8d" },
        { "action": "expectResource", "kind": "Pod", "name": "payments-api-7d9c9b7f8d-k2r9p", "namespace": "payments" },
        { "action": "toggleResourceGroup", "label": "Pods" },
        { "action": "expectResourceGroup", "label": "Pods", "expanded": false },
        { "action": "expectNoResource", "kind": "Pod", "name": "payments-api-7d9c9b7f8d-k2r9p", "namespace": "payments" },
        { "action": "toggleResourceGroup", "label": "Pods" },
        { "action": "expectResourceGroup", "label": "Pods", "expanded": true },
        { "action": "expectResource", "kind": "Pod", "name": "payments-api-7d9c9b7f8d-k2r9p", "namespace": "payments" },
        { "action": "toggleResourceGroup", "label": "Owned by Argo CD: shop (partial evidence)" },
        { "action": "expectResourceGroup", "label": "Owned by Argo CD: shop (partial evidence)", "expanded": false },
        { "action": "expectNoResource", "kind": "Pod", "name": "payments-api-7d9c9b7f8d-k2r9p", "namespace": "payments" },
        { "action": "toggleResourceGroup", "label": "Owned by Argo CD: shop (partial evidence)" },
        { "action": "expectResourceGroup", "label": "Owned by Argo CD: shop (partial evidence)", "expanded": true },
        { "action": "expectResource", "kind": "Pod", "name": "payments-api-7d9c9b7f8d-k2r9p", "namespace": "payments" }
      ]
    },
    {
      "id": "resources.ownerref-inherited-owner",
