        { "action": "expectResourceCell", "kind": "Pod", "name": "payments-api-7d9c9b7f8d-x4m8v", "namespace": "payments", "column": "Restarts", "text": "0" },
        { "action": "search", "value": "operations-crashloop" },
        { "action": "expectResourceCell", "kind": "Pod", "name": "operations-crashloop-7f468cd8b8-lab01", "namespace": "operations", "column": "Ready", "text": "0/1" },
