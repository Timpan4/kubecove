        { "action": "expectDetailClosed" },
        { "action": "openResourceRow", "kind": "Pod", "name": "payments-api-7d9c9b7f8d-x4m8v", "namespace": "payments", "column": "Kind" },
        { "action": "expectDetail", "kind": "Pod", "name": "payments-api-7d9c9b7f8d-x4m8v", "namespace": "payments" }
      ]
    },
    {
      "id": "resources.table-row-keyboard",
      "title": "Enter and Space on a focused resource row's name open that resource's detail",
      "steps": [
        { "action": "openResources" },
        { "action": "search", "value": "payments-api-7d9c9b7f8d" },
        { "action": "pressResourceRow", "kind": "Pod", "name": "payments-api-7d9c9b7f8d-k2r9p", "namespace": "payments", "key": "Enter" },
        { "action": "expectDetail", "kind": "Pod", "name": "payments-api-7d9c9b7f8d-k2r9p", "namespace": "payments" },
        { "action": "closeDetail" },
        { "action": "expectDetailClosed" },
        { "action": "pressResourceRow", "kind": "Pod", "name": "payments-api-7d9c9b7f8d-x4m8v", "namespace": "payments", "key": "Space" },
        { "action": "expectDetail", "kind": "Pod", "name": "payments-api-7d9c9b7f8d-x4m8v", "namespace": "payments" }
      ]
