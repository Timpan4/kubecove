        { "action": "expectResourceCell", "kind": "Pod", "name": "checkout-worker-6bfbd7d5dd-9qj2f", "namespace": "payments", "column": "Owner", "text": "flux-system/platform" },
        { "action": "chooseGitOpsOwner", "owner": "Owned by Argo CD: shop (partial evidence)" },
        { "action": "expectNoResource", "kind": "Pod", "name": "checkout-worker-6bfbd7d5dd-9qj2f", "namespace": "payments" },
        { "action": "chooseGitOpsOwner", "owner": "Owned by Flux Kustomization: flux-system/platform" },
        { "action": "expectResource", "kind": "Pod", "name": "checkout-worker-6bfbd7d5dd-9qj2f", "namespace": "payments" },
        { "action": "chooseGitOpsOwner", "owner": "All GitOps owners" }
      ]
    },
    {
      "id": "resources.table-row-open",
      "title": "Clicking any cell of a resource row opens its detail",
      "steps": [
        { "action": "openResources" },
        { "action": "search", "value": "payments-api-7d9c9b7f8d" },
        { "action": "openResourceRow", "kind": "Pod", "name": "payments-api-7d9c9b7f8d-k2r9p", "namespace": "payments", "column": "Namespace" },
        { "action": "expectDetail", "kind": "Pod", "name": "payments-api-7d9c9b7f8d-k2r9p", "namespace": "payments" },
