		{
			"id": "coverage-actions.revert-discard",
			"title": "Reverting replicas and discarding pending edits restore live values without applying",
			"steps": [
				{
					"action": "openResources"
				},
				{
					"action": "search",
					"value": "payments-api"
				},
				{
					"action": "openResource",
					"kind": "Deployment",
					"name": "payments-api",
					"namespace": "payments"
				},
				{
					"action": "showTab",
					"tab": "Actions"
				},
				{
					"action": "editReplicas",
					"value": "3"
				},
				{
					"action": "coverageClick",
					"label": "Revert"
				},
				{
					"action": "coverageCheck",
					"check": "replicas-reset"
				},
				{
					"action": "expectNoReview"
				},
				{
					"action": "expectNoActionResult"
				},
				{
					"action": "coverageFill",
					"label": "Desired replicas",
					"value": "4"
				},
				{
					"action": "coverageClick",
					"label": "Discard"
				},
				{
					"action": "coverageCheck",
					"check": "replicas-reset"
				},
				{
					"action": "coverageFill",
					"label": "Desired replicas",
					"value": "3"
				},
				{
					"action": "reviewAction",
					"label": "Check changes"
				},
				{
					"action": "expectReview",
					"title": "Review edit for payments-api",
					"description": "edit Deployment payments/payments-api in context mock-dev",
					"contains": [
						"-  replicas: 2",
						"+  replicas: 3"
					]
				},
				{
					"action": "closeReview"
				}
			]
		},
