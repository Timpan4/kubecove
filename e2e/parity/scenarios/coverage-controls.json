		{
			"id": "coverage-logs.order-pause-clear",
			"title": "Log order reverses exact rows, filtering shows empty feedback and clear leaves a paused buffer empty",
			"steps": [
				{
					"action": "openResources"
				},
				{
					"action": "search",
					"value": "payments-api"
				},
				{
					"action": "openResource",
					"kind": "Deployment",
					"name": "payments-api",
					"namespace": "payments"
				},
				{
					"action": "showTab",
					"tab": "Logs"
				},
				{
					"action": "expectLogLines",
					"lines": [
						"boot payments-api",
						"handled GET /healthz 200",
						"downstream retry budget at 82%"
					]
				},
				{
					"action": "coverageClick",
					"label": "Oldest first"
				},
				{
					"action": "expectLogLines",
					"lines": [
						"downstream retry budget at 82%",
						"handled GET /healthz 200",
						"boot payments-api"
					]
				},
				{
					"action": "coverageClick",
					"label": "Latest first"
				},
				{
					"action": "filterLogs",
					"value": "no-such-log"
				},
				{
					"action": "coverageText",
					"text": "No log lines match the current filters.",
					"visible": true
				},
				{
					"action": "filterLogs",
					"value": ""
				},
				{
					"action": "coverageClick",
					"label": "Pause"
				},
				{
					"action": "coverageClick",
					"label": "Clear"
				},
				{
					"action": "expectLogLines",
					"lines": []
				},
				{
					"action": "coverageText",
					"text": "Paused. New lines are held until you resume.",
					"visible": true
				},
				{
					"action": "coverageClick",
					"label": "Resume"
				}
			]
		},
