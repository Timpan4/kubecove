        { "action": "expectPageText", "text": "Completed" },
        { "action": "expectPageText", "text": "sidecar" },
        { "action": "expectPageText", "text": "waiting - CrashLoopBackOff" },
        { "action": "expectPageText", "text": "debugger" }
      ]
    }
  ]
}
