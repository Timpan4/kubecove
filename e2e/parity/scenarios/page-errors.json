      "id": "page-errors.rbac.failed-read",
      "title": "A failed RBAC read classifies by its credential kind, not its message",
      "steps": [
        {
          "action": "mockTiming",
          "control": {
            "operation": "fail",
            "command": "list_rbac_inspection",
            "context": "mock-dev",
            "kind": "credentialUnavailable"
          }
        },
        {
          "action": "openPage",
          "page": "RBAC"
        },
        {
          "action": "expectFriendlyError",
          "title": "Kubernetes authentication failed",
          "next": "Sign in through the selected context's credential provider or refresh its credentials, then retry."
        },
        {
          "action": "mockTiming",
          "control": {
            "operation": "release",
            "command": "list_rbac_inspection",
            "context": "mock-dev"
          }
        }
