{
  "fixture": "browser-mocks",
  "context": "mock-dev",
  "scenarios": [
    {
      "id": "argo-connected.forget-profile",
      "title": "Forget removes saved metadata and its credential across restart",
      "steps": [
        {
          "action": "openPage",
          "page": "GitOps"
        },
        {
          "action": "openGitOpsDetails",
          "kind": "Application",
          "name": "tenant-ledger",
          "namespace": "argocd"
        },
        {
          "action": "connectArgoProfile",
          "url": "https://argocd.example.test",
          "remember": true
        },
        {
          "action": "argoControl",
          "control": "Forget",
          "url": "https://argocd.example.test"
        },
        {
          "action": "restartClient"
        },
        {
          "action": "openPage",
          "page": "GitOps"
        },
        {
          "action": "openGitOpsDetails",
          "kind": "Application",
          "name": "tenant-ledger",
          "namespace": "argocd"
        },
        {
          "action": "expectNoSavedArgoProfile",
          "url": "https://argocd.example.test"
        }
      ]
    },
    {
      "id": "argo-review.hard-refresh",
      "title": "Hard refresh and normal refresh review distinct canonical actions",
      "steps": [
        {
          "action": "openPage",
          "page": "GitOps"
        },
        {
          "action": "openGitOpsDetails",
          "kind": "Application",
          "name": "tenant-ledger",
          "namespace": "argocd"
        },
        {
          "action": "connectArgoProfile",
          "url": "https://argocd.example.test",
          "remember": true
        },
        {
          "action": "reviewArgoOperation",
          "operation": "Hard refresh"
        },
        {
          "action": "expectArgoReview",
          "operation": "hardRefresh",
          "name": "tenant-ledger",
          "namespace": "argocd",
          "transport": "connected"
        },
        {
          "action": "cancelArgoReview"
        },
        {
          "action": "reviewArgoOperation",
          "operation": "Refresh"
        },
        {
          "action": "expectArgoReview",
          "operation": "refresh",
          "name": "tenant-ledger",
          "namespace": "argocd",
          "transport": "connected"
        },
        {
          "action": "cancelArgoReview"
        }
      ]
    },
    {
      "id": "argo-review.retry-preflight",
      "title": "Retry obtains a fresh review after a failed exact Application preflight",
      "steps": [
        {
          "action": "openPage",
          "page": "GitOps"
        },
        {
          "action": "openGitOpsDetails",
          "kind": "Application",
          "name": "tenant-ledger",
          "namespace": "argocd"
        },
        {
          "action": "configureArgoMock",
          "script": "operation-error"
        },
        {
          "action": "reviewArgoOperation",
          "operation": "Refresh"
        },
        {
          "action": "expectArgoText",
          "text": "Fixture preflight unavailable"
        },
        {
          "action": "configureArgoMock",
          "script": "base"
        },
        {
          "action": "argoControl",
          "control": "Retry operation"
        },
        {
          "action": "expectArgoReview",
          "operation": "refresh",
          "name": "tenant-ledger",
          "namespace": "argocd",
          "transport": "kubernetes"
        },
        {
          "action": "cancelArgoReview"
        }
      ]
    },
