    {
      "id": "argo-connected.lazy-comparison",
      "title": "An oversized snapshot loads the focused resource comparison through its exact identity",
      "steps": [
        {
          "action": "openPage",
          "page": "GitOps"
        },
        {
          "action": "openGitOpsDetails",
          "kind": "Application",
