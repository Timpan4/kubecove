{
  "fixture": "browser-mocks",
  "context": "mock-dev",
  "scenarios": [
    {
      "id": "control-motion.switch",
      "title": "A setting's switch slides its thumb to the new state over 150 ms instead of jumping",
      "steps": [
        { "action": "openSettings" },
        { "action": "showSettingsSection", "section": "General" },
        { "action": "coverageCheck", "check": "motion:switch:start" },
        { "action": "advanceClock", "ms": 75 },
        { "action": "coverageCheck", "check": "motion:switch:midway" },
        { "action": "advanceClock", "ms": 75 },
        { "action": "coverageCheck", "check": "motion:switch:settled" }
      ]
    },
    {
      "id": "control-motion.segment",
      "title": "A segmented control slides its pill to the chosen option over 150 ms",
      "steps": [
        { "action": "openPage", "page": "GitOps" },
        { "action": "coverageCheck", "check": "motion:segment:start" },
        { "action": "advanceClock", "ms": 75 },
        { "action": "coverageCheck", "check": "motion:segment:midway" },
        { "action": "advanceClock", "ms": 75 },
        { "action": "coverageCheck", "check": "motion:segment:settled" }
      ]
    },
    {
      "id": "control-motion.tab",
      "title": "The detail tabs' underline slides to the chosen tab over 150 ms",
      "steps": [
        { "action": "openResources" },
        { "action": "search", "value": "payments-api" },
        { "action": "openResource", "kind": "Deployment", "name": "payments-api", "namespace": "payments" },
        { "action": "expectDetail", "kind": "Deployment", "name": "payments-api", "namespace": "payments" },
        { "action": "coverageCheck", "check": "motion:tab:start" },
        { "action": "advanceClock", "ms": 75 },
        { "action": "coverageCheck", "check": "motion:tab:midway" },
        { "action": "advanceClock", "ms": 75 },
        { "action": "coverageCheck", "check": "motion:tab:settled" }
      ]
    },
    {
      "id": "control-motion.tab-resizes-list",
      "title": "The detail tabs' underline slides to the Actions tab over 150 ms though its panel changes the tab list's height",
      "steps": [
        { "action": "openResources" },
        { "action": "search", "value": "payments-api" },
        { "action": "openResource", "kind": "Deployment", "name": "payments-api", "namespace": "payments" },
        { "action": "expectDetail", "kind": "Deployment", "name": "payments-api", "namespace": "payments" },
        { "action": "coverageCheck", "check": "motion:tab-actions:start" },
        { "action": "advanceClock", "ms": 75 },
        { "action": "coverageCheck", "check": "motion:tab-actions:midway" },
        { "action": "advanceClock", "ms": 75 },
        { "action": "coverageCheck", "check": "motion:tab-actions:settled" }
      ]
    },
    {
      "id": "control-motion.segment-turns-back",
      "title": "A segmented control's pill turns back from where it is when the first option is chosen again mid-slide",
      "steps": [
        { "action": "openPage", "page": "GitOps" },
        { "action": "coverageCheck", "check": "motion:segment:start" },
        { "action": "advanceClock", "ms": 75 },
        { "action": "coverageCheck", "check": "motion:segment:midway" },
        { "action": "coverageCheck", "check": "motion:segment:back" },
        { "action": "advanceClock", "ms": 150 },
        { "action": "coverageCheck", "check": "motion:segment:returned" }
      ]
    },
    {
      "id": "control-motion.tab-turns-back",
      "title": "The detail tabs' underline turns back from where it is when the first tab is chosen again mid-slide",
      "steps": [
        { "action": "openResources" },
        { "action": "search", "value": "payments-api" },
        { "action": "openResource", "kind": "Deployment", "name": "payments-api", "namespace": "payments" },
        { "action": "expectDetail", "kind": "Deployment", "name": "payments-api", "namespace": "payments" },
        { "action": "coverageCheck", "check": "motion:tab:start" },
        { "action": "advanceClock", "ms": 75 },
        { "action": "coverageCheck", "check": "motion:tab:midway" },
        { "action": "coverageCheck", "check": "motion:tab:back" },
        { "action": "advanceClock", "ms": 150 },
        { "action": "coverageCheck", "check": "motion:tab:returned" }
      ]
    },
    {
      "id": "control-motion.segment-reduced",
      "title": "Under reduced motion a segmented control shows the chosen option at once",
      "steps": [
        { "action": "setReducedMotion", "reduce": true },
        { "action": "openPage", "page": "GitOps" },
        { "action": "coverageCheck", "check": "motion:segment:instant" }
      ]
    },
    {
      "id": "control-motion.tab-reduced",
      "title": "Under reduced motion the detail tabs show the underline under the chosen tab at once",
      "steps": [
        { "action": "setReducedMotion", "reduce": true },
        { "action": "openResources" },
        { "action": "search", "value": "payments-api" },
        { "action": "openResource", "kind": "Deployment", "name": "payments-api", "namespace": "payments" },
        { "action": "expectDetail", "kind": "Deployment", "name": "payments-api", "namespace": "payments" },
        { "action": "coverageCheck", "check": "motion:tab:instant" }
      ]
    },
    {
      "id": "control-motion.row-hover",
      "title": "A resource row fades to its hover background over 150 ms",
      "steps": [
        { "action": "openResources" },
        { "action": "search", "value": "payments-api" },
        { "action": "expectResource", "kind": "Deployment", "name": "payments-api", "namespace": "payments" },
        { "action": "coverageCheck", "check": "motion:row:start" },
        { "action": "advanceClock", "ms": 75 },
        { "action": "coverageCheck", "check": "motion:row:midway" },
        { "action": "advanceClock", "ms": 75 },
        { "action": "coverageCheck", "check": "motion:row:settled" }
      ]
    },
    {
      "id": "control-motion.button-hover",
      "title": "A button fades to its hover background over 150 ms",
      "steps": [
        { "action": "openResources" },
        { "action": "search", "value": "payments-api" },
        { "action": "openResource", "kind": "Deployment", "name": "payments-api", "namespace": "payments" },
        { "action": "showTab", "tab": "YAML" },
        { "action": "expectYaml", "contains": ["kind: Deployment"] },
        { "action": "coverageCheck", "check": "motion:button:start" },
        { "action": "advanceClock", "ms": 75 },
        { "action": "coverageCheck", "check": "motion:button:midway" },
        { "action": "advanceClock", "ms": 75 },
        { "action": "coverageCheck", "check": "motion:button:settled" }
      ]
    },
    {
      "id": "control-motion.sidebar-chevron",
      "title": "A sidebar branch turns its chevron over 150 ms as it opens",
      "steps": [
        { "action": "openResources" },
        { "action": "expectSidebarRow", "path": ["Workloads"], "visible": true, "selected": false },
        { "action": "coverageCheck", "check": "motion:chevron:start" },
        { "action": "advanceClock", "ms": 75 },
        { "action": "coverageCheck", "check": "motion:chevron:midway" },
        { "action": "advanceClock", "ms": 75 },
        { "action": "coverageCheck", "check": "motion:chevron:settled" }
      ]
    },
    {
      "id": "control-motion.sidebar-unfold",
      "title": "A sidebar branch unfolds its rows over 150 ms, moving the row under it down",
      "steps": [
        { "action": "openResources" },
        { "action": "expectSidebarRow", "path": ["Workloads"], "visible": true, "selected": false },
        { "action": "expectSidebarRow", "path": ["Network"], "visible": true, "selected": false },
        { "action": "coverageCheck", "check": "motion:branch:start" },
        { "action": "advanceClock", "ms": 75 },
        { "action": "coverageCheck", "check": "motion:branch:midway" },
        { "action": "advanceClock", "ms": 75 },
        { "action": "coverageCheck", "check": "motion:branch:settled" },
        { "action": "expectSidebarRow", "path": ["Workloads", "Pod"], "visible": true, "selected": false }
      ]
    },
    {
      "id": "control-motion.sidebar-unfold-reduced",
      "title": "Reduced motion turned on while a sidebar branch unfolds ends the fold at once",
      "steps": [
        { "action": "openResources" },
        { "action": "expectSidebarRow", "path": ["Workloads"], "visible": true, "selected": false },
        { "action": "expectSidebarRow", "path": ["Network"], "visible": true, "selected": false },
        { "action": "coverageCheck", "check": "motion:branch:start" },
        { "action": "advanceClock", "ms": 75 },
        { "action": "coverageCheck", "check": "motion:branch:midway" },
        { "action": "setReducedMotion", "reduce": true },
        { "action": "coverageCheck", "check": "motion:branch:ended" },
        { "action": "expectSidebarRow", "path": ["Workloads", "Pod"], "visible": true, "selected": false }
      ]
    },
    {
      "id": "control-motion.sidebar-unfold-collapse-all",
      "title": "Collapse all while a sidebar branch unfolds closes the branch at once",
      "steps": [
        { "action": "openResources" },
        { "action": "expectSidebarRow", "path": ["Workloads"], "visible": true, "selected": false },
        { "action": "expectSidebarRow", "path": ["Network"], "visible": true, "selected": false },
        { "action": "coverageCheck", "check": "motion:branch:start" },
        { "action": "advanceClock", "ms": 75 },
        { "action": "coverageCheck", "check": "motion:branch:midway" },
        { "action": "collapseSidebar" },
        { "action": "coverageCheck", "check": "motion:branch:collapsed" },
        { "action": "expectSidebarRow", "path": ["Workloads", "Pod"], "visible": false, "selected": false }
      ]
    },
    {
      "id": "control-motion.sidebar-unfold-inert",
      "title": "A sidebar branch's rows take no focus or clicks while it unfolds, and do once it has",
      "steps": [
        { "action": "openResources" },
        { "action": "expectSidebarRow", "path": ["Workloads"], "visible": true, "selected": false },
        { "action": "expectSidebarRow", "path": ["Network"], "visible": true, "selected": false },
        { "action": "coverageCheck", "check": "motion:branch:start" },
        { "action": "advanceClock", "ms": 75 },
        { "action": "coverageCheck", "check": "motion:branch:midway" },
        { "action": "coverageCheck", "check": "motion:branch:inert" },
        { "action": "advanceClock", "ms": 75 },
        { "action": "coverageCheck", "check": "motion:branch:settled" },
        { "action": "sidebarSelect", "path": ["Workloads", "Pod"] },
        { "action": "expectSidebarRow", "path": ["Workloads", "Pod"], "visible": true, "selected": true }
      ]
    },
    {
      "id": "control-motion.sidebar-fold-inert",
      "title": "A sidebar branch's rows take no focus or clicks while it folds closed",
      "steps": [
        { "action": "openResources" },
        { "action": "sidebarToggle", "path": ["Workloads"] },
        { "action": "sidebarSelect", "path": ["Workloads", "Deployment"] },
        { "action": "expectSidebarRow", "path": ["Workloads", "Deployment"], "visible": true, "selected": true },
        { "action": "expectSidebarRow", "path": ["Workloads", "Pod"], "visible": true, "selected": false },
        { "action": "expectSidebarRow", "path": ["Network"], "visible": true, "selected": false },
        { "action": "coverageCheck", "check": "motion:branch:start" },
        { "action": "advanceClock", "ms": 75 },
        { "action": "coverageCheck", "check": "motion:branch:midway" },
        { "action": "coverageCheck", "check": "motion:branch:inert" }
      ]
    },
    {
      "id": "control-motion.sidebar-unfold-custom",
      "title": "A custom resource group unfolds its kinds over 150 ms, moving the group under it down without passing its place",
      "steps": [
        { "action": "openResources" },
        { "action": "sidebarToggle", "path": ["Workloads"] },
        { "action": "sidebarToggle", "path": ["Network"] },
        { "action": "sidebarToggle", "path": ["Config"] },
        { "action": "sidebarToggle", "path": ["Storage"] },
        { "action": "expandNav", "page": "Custom Resources" },
        { "action": "expectCustomGroup", "group": "argoproj.io", "visible": true },
        { "action": "expectCustomGroup", "group": "helm.toolkit.fluxcd.io", "visible": true },
        { "action": "coverageCheck", "check": "motion:custom-group:start" },
        { "action": "advanceClock", "ms": 75 },
        { "action": "coverageCheck", "check": "motion:custom-group:midway" },
        { "action": "advanceClock", "ms": 75 },
        { "action": "coverageCheck", "check": "motion:custom-group:settled" }
      ]
    }
  ]
}
