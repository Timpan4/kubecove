{
  "fixture": "browser-mocks",
  "context": "mock-dev",
  "scenarios": [
    {
      "id": "forward-start.exact-pod-ports",
      "title": "A Pod forward starts on the selected target and ports and disappears on stop",
      "steps": [
        { "action": "openResources" },
        { "action": "openResource", "kind": "Pod", "namespace": "payments", "name": "payments-api-7d9c9b7f8d-k2r9p" },
        { "action": "showTab", "tab": "Forward" },
        { "action": "configureForward", "remote": "9090", "local": "19090" },
        { "action": "forwardControl", "operation": "start" },
        { "action": "expectForwardState", "target": "Pod/payments-api-7d9c9b7f8d-k2r9p:9090", "local": "19090", "status": "listening", "count": 1 },
        { "action": "forwardControl", "operation": "stop", "target": "Pod/payments-api-7d9c9b7f8d-k2r9p:9090" },
        { "action": "expectForwardState", "target": "Pod/payments-api-7d9c9b7f8d-k2r9p:9090", "local": "19090", "status": "stopped", "count": 0 }
      ]
    },
    {
      "id": "forward-save.preset-notice",
      "title": "Saving a Service preset reports success as a neutral notice, and saving it again says it is already saved",
      "steps": [
        { "action": "openResources" },
        { "action": "openResource", "kind": "Service", "namespace": "payments", "name": "payments-api" },
        { "action": "showTab", "tab": "Forward" },
        { "action": "configureForward", "remote": "80", "local": "18083" },
        { "action": "forwardControl", "operation": "save" },
        { "action": "expectForwardNotice", "title": "Service preset", "text": "Saved Service forward to this workspace." },
        { "action": "forwardControl", "operation": "save" },
        { "action": "expectForwardNotice", "title": "Service preset", "text": "Preset already saved for this Service." }
      ]
    },
    {
      "id": "forward-active.service-reconnect-preset",
      "title": "A saved Service forward preserves ports, resolves its selector and reconnects without duplication",
      "steps": [
        { "action": "openResources" },
        { "action": "openResource", "kind": "Service", "namespace": "payments", "name": "payments-api" },
        { "action": "showTab", "tab": "Forward" },
        { "action": "configureForward", "remote": "80", "local": "18081" },
        { "action": "forwardControl", "operation": "save" },
        { "action": "closeDetail" },
        { "action": "openPage", "page": "Port Forwards" },
        { "action": "forwardControl", "operation": "restore" },
        { "action": "expectForwardState", "target": "Service/payments-api:80", "local": "18081", "status": "listening", "resolved": "payments-api-7d9c9b7f8d-k2r9p:8080", "count": 1 },
        { "action": "replaySessions", "script": "reconnecting" },
        { "action": "expectForwardState", "target": "Service/payments-api:80", "local": "18081", "status": "reconnecting", "count": 1 },
        { "action": "replaySessions", "script": "failed" },
        { "action": "expectForwardState", "target": "Service/payments-api:80", "local": "18081", "status": "error", "count": 1 },
        { "action": "forwardControl", "operation": "reconnect", "target": "Service/payments-api:80" },
        { "action": "expectForwardState", "target": "Service/payments-api:80", "local": "18081", "status": "listening", "resolved": "payments-api-7d9c9b7f8d-k2r9p:8080", "count": 1 },
        { "action": "forwardControl", "operation": "stop", "target": "Service/payments-api:80" },
        { "action": "expectForwardState", "target": "Service/payments-api:80", "local": "18081", "status": "stopped", "count": 0 }
      ]
    },
    {
      "id": "exec-session.container-output-cleanup",
      "title": "Exec uses the confirmed container, isolates output and stops when its session closes",
      "steps": [
        { "action": "openResources" },
        { "action": "openResource", "kind": "Pod", "namespace": "payments", "name": "payments-api-7d9c9b7f8d-k2r9p" },
        { "action": "showTab", "tab": "Exec" },
        { "action": "execControl", "operation": "start", "container": "app", "command": "/bin/sh" },
        { "action": "expectExecState", "container": "app", "status": "running", "contains": "Controlled exec app" },
        { "action": "replaySessions", "script": "foreign-output" },
        { "action": "expectExecState", "container": "app", "status": "running", "contains": "Controlled exec app", "absent": "FOREIGN SESSION OUTPUT" },
        { "action": "execControl", "operation": "input", "data": "printf parity\r" },
        { "action": "expectExecState", "container": "app", "status": "running", "contains": "parity" },
        { "action": "execControl", "operation": "close" },
        { "action": "expectExecState", "container": "app", "status": "closed", "contains": "" },
        { "action": "closeDetail" }
      ]
    },
    {
      "id": "exec-session.sidecar-isolation",
      "title": "Container selection and tab switching keep each terminal's output separate",
      "steps": [
        { "action": "openResources" },
        { "action": "openResource", "kind": "Pod", "namespace": "payments", "name": "payments-api-7d9c9b7f8d-k2r9p" },
        { "action": "showTab", "tab": "Exec" },
        { "action": "execControl", "operation": "start", "container": "sidecar", "command": "/bin/sh" },
        { "action": "expectExecState", "container": "sidecar", "status": "running", "contains": "Controlled exec sidecar", "absent": "Controlled exec app" },
        { "action": "execControl", "operation": "start", "container": "app", "command": "/bin/sh" },
        { "action": "expectExecState", "container": "app", "status": "running", "contains": "Controlled exec app", "absent": "Controlled exec sidecar" },
        { "action": "execControl", "operation": "select", "container": "sidecar", "tab": 0 },
        { "action": "expectExecState", "container": "sidecar", "status": "running", "contains": "Controlled exec sidecar", "absent": "Controlled exec app" },
        { "action": "execControl", "operation": "close", "container": "sidecar", "tab": 0 },
        { "action": "execControl", "operation": "close", "container": "app", "tab": 1 },
        { "action": "expectExecState", "container": "app", "status": "closed", "contains": "" }
      ]
    },
